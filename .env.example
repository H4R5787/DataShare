# SECURE PASS RxQ — Environment Configuration Template
# Copy to .env for local runtime configuration

# Application
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security (Generate a 64-char random string in production)
SECRET_KEY=dev-insecure-secret-key-change-in-production-rxq-991823
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (SQLite async default for zero-dependency local dev; PostgreSQL for production)
# SQLite:
DATABASE_URL=sqlite+aiosqlite:///./secure_pass.db
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/secure_pass_rxq

# Telecom Provider Integration Mode (mock | live)
TELECOM_MODE=mock
MOCK_SIMULATE_LATENCY_MS=200
# Production credentials (only when TELECOM_MODE=live):
# JIO_PARTNER_API_KEY=
# AIRTEL_IQ_API_KEY=
# VI_GATEWAY_SECRET=
# BSNL_MERCHANT_ID=

# Payment Gateway Integration Mode (mock | live)
PAYMENT_MODE=mock
# Production credentials (only when PAYMENT_MODE=live):
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# OTP Service (mock | twilio | fast2sms)
ENABLE_MOCK_OTP=true
MOCK_OTP_DEFAULT=123456
OTP_EXPIRE_SECONDS=300
